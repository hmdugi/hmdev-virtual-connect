# 실값은 서버 환경변수에만 입력. Git에 커밋하지 않습니다.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_IDS=
APP_ORIGIN=
# Turnstile이 설정된 Supabase Auth는 토큰도 요청에 전달합니다.
TURNSTILE_SITE_KEY=

# 권장: API proxy only; no Supabase secret copied to Vercel.
VIRTUAL_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/virtual-api
